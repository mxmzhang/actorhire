<!DOCTYPE html>
<html lang="en">
<head>
    {{>head}}
</head>
<body>
    {{>navbar}}
    <div class="d-flex flex-column vh-100 align-items-center justify-content-center text-center">
        <form action="/user-choice-response" method="POST" class="w-100" style="max-width: 400px;">
            <div class="mb-3">
            <label class="form-label">Are you:</label>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="role" id="looking" value="looking" required>
                <label class="form-check-label" for="looking">
                Looking for services
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="role" id="providing" value="providing" required>
                <label class="form-check-label" for="providing">
                Providing services
                </label>
            </div>
            </div>
            
            <button type="submit" class="btn btn-primary">Next</button>
        </form>
    </div>
</body>
</html>
