<!DOCTYPE html>
<html>
  {{> head}}
  <body>
    {{> navbar}}

    <div class="container mt-5 ms-4">
      <h3>{{name}}</h3>
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h5>Bookings</h5>
        <a href="/signout" class="btn btn-outline-danger">Sign Out</a>
      </div>

      {{#each arr}}
        <div class="card mb-3">
          <div
            class="card-header
                   {{#if this.accepted}}
                     bg-success text-white
                   {{else}}
                     bg-danger text-white
                   {{/if}}
            "
          >
            {{#if this.accepted}}
              Accepted
            {{else}}
              Not Accepted
            {{/if}}
          </div>

          <!-- Card Body -->
          <div class="card-body">
            <p class="card-text">
              <strong>Request:</strong> {{this.request}}
            </p>
            <p class="card-text">
              <strong>Date:</strong> {{this.date}}
            </p>
            <p class="card-text">
              <strong>Time:</strong> {{this.time}}
            </p>
            <div class="d-flex gap-2">
              <form action="/accept/{{this.id}}" method="POST">
                <button type="submit" class="btn btn-primary">
                  Accept
                </button>
              </form>

              <form action="/decline/{{this.id}}" method="POST">
                <button type="submit" class="btn btn-danger">
                  Decline
                </button>
              </form>
            </div>
          </div>
        </div>
      {{/each}}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  </body>
</html>